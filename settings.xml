<AppSettings>
  <preset>medium</preset>
  <crf>100</crf>
  <audio>aac</audio>
  <container>mkv</container>
  <audiobitrate>128k</audiobitrate>
  <checkBox180>false</checkBox180>
  <checkBox90clockwise>false</checkBox90clockwise>
  <checkBox90counterclockwise>false</checkBox90counterclockwise>
  <checkBoxVideoOnly>false</checkBoxVideoOnly>
  <checkBoxAudioOnly>false</checkBoxAudioOnly>
  <out_path></out_path>
  <audio_stream>1</audio_stream>
  <h265>false</h265>
  <radioButton_1080p>false</radioButton_1080p>
  <radioButton_720p>false</radioButton_720p>
  <radioButton_480p>false</radioButton_480p>
  <radioButton_No_Video_Resize>true</radioButton_No_Video_Resize>
  <checkBoxSetFPS>false</checkBoxSetFPS>  //use FPS
  <textBoxFPSout></textBoxFPSout>  //set FPS
  <checkBoxSlowFPS>false</checkBoxSlowFPS>  //use slow motion
  <textBoxSlowFPS></textBoxSlowFPS>   //set slow motion factor
  <checkBoxTransRemoveSubtitle>true</checkBoxTransRemoveSubtitle>
  <checkBoxTranscodeAllStreams>false</checkBoxTranscodeAllStreams>
  <checkBoxKeepExtension>false</checkBoxKeepExtension>
  <checkBoxCopyDuration>false</checkBoxCopyDuration>
  <textBoxFromTime>00:00:00</textBoxFromTime>
  <textBoxCopyDuration>01:00</textBoxCopyDuration>
  <numericUpDownVideoNr>0</numericUpDownVideoNr>
  <numericUpDownAudioNr>0</numericUpDownAudioNr>
</AppSettings>
